<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen: the icon on the app's dark background. -->
    <style name="IptvLaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/iptv_background</item>
        <item name="android:statusBarColor">@color/iptv_background</item>
        <item name="android:navigationBarColor">@color/iptv_background</item>
        <item name="android:windowSplashScreenBackground">@color/iptv_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/iptv_accent</item>
    </style>
</resources>
